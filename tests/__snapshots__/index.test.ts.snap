// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`types fails if strategy is invalid 1`] = `"Invalid strategy "invalid". Valid strategies are: inline-svg, inline-png"`;

exports[`types fails if cwd is not provided when using imports 1`] = `"To use imports, you must provide a "cwd" option (directory to resolve imports from)"`;

exports[`types fails if using globalImports without cwd 1`] = `"To use globalImports, you must provide a "cwd" option (directory to resolve imports from)"`;

exports[`types fails if using globalImports with a file that doesn't exist 1`] = `"Invalid imports: invalid.d2 for theme a, found files: [global.d2, vars.d2]"`;

